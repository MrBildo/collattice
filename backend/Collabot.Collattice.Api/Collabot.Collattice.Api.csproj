<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Pin the .NET runtime this project's self-contained publish bundles into
         every release archive. The archive carries the entire runtime, so an
         operator runs whatever version we packaged and cannot patch it from their
         own machine; pinning (rather than floating to whatever runtime the build
         SDK happens to ship) makes a rebuild from a given source revision produce
         the same runtime, and turns a servicing update into a deliberate, reviewed
         change instead of one that lands silently. This one value drives both the
         base runtime and the ASP.NET Core shared-framework packs. Bump it with
         scripts/bump-runtime.sh, which rewrites this line and regenerates
         THIRD-PARTY-NOTICES.md together; the CI runtime-currency gate goes red
         when it falls behind the current .NET servicing release. -->
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Ulid" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Collabot.Collattice.ServiceDefaults\Collabot.Collattice.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Collabot.Collattice.Api.Tests" />
  </ItemGroup>
</Project>
